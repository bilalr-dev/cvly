# ============================================================
# Cvly Configuration
# Copy this file to .env and fill in your API keys
# All APIs below have free tiers sufficient for personal use
# ============================================================

# --- Google Gemini (REQUIRED) ---
# Sign up: https://aistudio.google.com/apikey
# Free tier: 15 requests/min, 1,500/day
GEMINI_API_KEY=

# --- Groq ---
# Sign up: https://console.groq.com
# Free tier: 30 RPM, 14,400 req/day
GROQ_API_KEY=

# --- France Travail / Pôle Emploi (recommended for French market) ---
# Sign up: https://francetravail.io/data/api
# Free tier: 1,000 calls/day
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# --- Adzuna (recommended) ---
# Sign up: https://developer.adzuna.com/
# Free tier: 250 calls/day
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- JSearch / RapidAPI (optional) ---
# Sign up: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# Free tier: 200 calls/month
JSEARCH_API_KEY=


# --- Google Sheets Tracking (optional) ---
# Create a service account: https://console.cloud.google.com/iam-admin/serviceaccounts
# Download the JSON key and place it at the path below
GOOGLE_SERVICE_ACCOUNT_PATH=config/google_service_account.json
GOOGLE_SHEET_ID=

# --- App Settings ---
APP_PORT=8000
MATCH_THRESHOLD=50
DEFAULT_LANGUAGE=fr
DEFAULT_COUNTRY=FR
