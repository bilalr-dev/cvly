# ============================================================
# Cvly - environment file template
# ------------------------------------------------------------
# 1. Copy this file:  cp .env.example .env
# 2. Fill the keys using the step-by-step guide in README.md
#    English: section "5. Environment setup"
#    Français : section "5. Configuration du fichier .env"
# All services below have free tiers suitable for personal use.
# Leave optional keys empty if you do not use that service.
# ============================================================

# --- 1. Google Gemini (REQUIRED) ---
# Exact page: https://aistudio.google.com/apikey
# Click "Create API key" → paste below
GEMINI_API_KEY=

# --- 2. Groq (recommended - independent critic for Gemini output) ---
# Console: https://console.groq.com
# Create key: https://console.groq.com/keys
# Free tier ~30 RPM. Prefer the 8B model to stay within free limits.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Alternative (higher quality, burns free quota faster):
# GROQ_MODEL=llama-3.3-70b-versatile

# --- 3. France Travail / Pôle Emploi (recommended for French market) ---
# Account: https://francetravail.io
# API page: https://francetravail.io/data/api/offres-emploi
# Steps: Utiliser l'API → create app → subscribe to "Offres d'emploi v2"
#   → copy Identifiant client (PAR_...) and Clé secrète
# Free tier ~1,000 calls/day
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# --- 4. Adzuna (recommended) ---
# Sign up: https://developer.adzuna.com/
# Application type: "Personal or academic research"
# Free tier ~250 calls/day
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- 5. Arbeitnow + Remotive + Jobicy ---
# No keys required. Enabled automatically when the app starts.

# --- 6. JSearch / RapidAPI (optional) ---
# Exact page: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# Subscribe to BASIC ($0.00/mo) → copy X-RapidAPI-Key
# Free tier ~200 calls/month
JSEARCH_API_KEY=

# --- 7. La Bonne Alternance (recommended for alternance / stage) ---
# Create account + token: https://api.apprentissage.beta.gouv.fr/fr/compte/profil
# API explorer: https://api.apprentissage.beta.gouv.fr/fr/explorer/recherche-offre
# Only queried when Alternance or Stage is selected in Settings
LA_BONNE_ALTERNANCE_API_KEY=

# --- 8. Google Sheets tracking (optional) ---
# Credentials: https://console.cloud.google.com/apis/credentials
#   → Create service account → Keys → JSON → save as path below
# Enable Sheets API: https://console.cloud.google.com/apis/library/sheets.googleapis.com
# Enable Drive API:  https://console.cloud.google.com/apis/library/drive.googleapis.com
# Share your Sheet with the service account email (Editor)
# Sheet ID = the middle part of docs.google.com/spreadsheets/d/SHEET_ID/edit
GOOGLE_SERVICE_ACCOUNT_PATH=config/google_service_account.json
GOOGLE_SHEET_ID=

# --- 9. App settings (safe defaults) ---
APP_PORT=8000
MATCH_THRESHOLD=50
DEFAULT_LANGUAGE=fr
DEFAULT_COUNTRY=FR
